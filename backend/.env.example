NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# Include the intended database name as the URI path. The current project uses hcm_lite.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/hcm_lite?retryWrites=true&w=majority
# Optional Atlas/local connection used only by the isolated MongoDB end-to-end test.
MONGODB_TEST_URI=

# Generate distinct, high-entropy values; do not use these placeholders as secrets.
JWT_ACCESS_SECRET=REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_REFRESH_SECRET=REPLACE_WITH_A_DIFFERENT_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_EXPIRES_IN=7d
FACE_ENCRYPTION_KEY=REPLACE_WITH_64_HEX_CHARACTERS_FROM_32_RANDOM_BYTES
FACE_MATCH_THRESHOLD=0.48

ADMIN_EMAIL=
ADMIN_PASSWORD=
GEMINI_API_KEY=
AI_MODEL=gemini-3.8-flash
AI_TIMEOUT_MS=30000
